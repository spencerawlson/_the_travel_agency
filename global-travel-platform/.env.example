# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=development            # development | production
HTTP_PORT=8080                     # host port Nginx listens on
LOG_LEVEL=INFO

# --- Secrets (required) ----------------------------------------------------------
POSTGRES_USER=gtp
POSTGRES_DB=gtp
POSTGRES_PASSWORD=change-me-to-a-long-random-value
SECRET_KEY=change-me-to-a-random-value-of-at-least-32-characters

# --- Security ------------------------------------------------------------------
# Comma-separated exact origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:8080
# Must be true in production (HTTPS only cookies + HSTS).
COOKIE_SECURE=false
# OpenAPI docs at /api/docs (always disabled when ENVIRONMENT=production).
ENABLE_DOCS=true
# Bearer token for /api/v1/metrics (blocked at Nginx; for internal scrapers).
METRICS_TOKEN=
# Optional error monitoring.
SENTRY_DSN=

# --- Development admin (ENVIRONMENT=development only) ----------------------------
# Created once by the migrate service. Min 12 chars. Leave empty to skip.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=change-me-dev-admin-pass

# --- Site identity & legal (shown on public pages) -------------------------------
# Brand (farelune.com registered 2026-10-12; formal trademark clearance pending).
SITE_NAME=Farelune
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
CONTACT_EMAIL=
PRIVACY_EMAIL=

# --- Optional: Travelpayouts partner script (Drive/Emerald) -----------------------
# Leave empty to disable (default). When set, the snippet is placed in every page,
# inert until a visitor accepts partner cookies in the consent banner (Law 25).
# The ID is the number in your dashboard snippet (?t=584743).
TRAVELPAYOUTS_SCRIPT_ID=
# Script host from the snippet (default emrldtp.cc).
TRAVELPAYOUTS_SCRIPT_HOST=
