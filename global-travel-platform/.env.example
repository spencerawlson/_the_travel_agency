# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=development            # development | production
HTTP_PORT=8080                     # host port Nginx listens on
LOG_LEVEL=INFO

# --- Secrets (required) ----------------------------------------------------------
POSTGRES_USER=gtp
POSTGRES_DB=gtp
POSTGRES_PASSWORD=change-me-to-a-long-random-value
SECRET_KEY=change-me-to-a-random-value-of-at-least-32-characters

# --- Security ------------------------------------------------------------------
# Comma-separated exact origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:8080
# Must be true in production (HTTPS only cookies + HSTS).
COOKIE_SECURE=false
# OpenAPI docs at /api/docs (always disabled when ENVIRONMENT=production).
ENABLE_DOCS=true
# true = admins must turn on two-step sign-in (authenticator app) before using the
# dashboard. Turn it on once every admin has set it up (Dashboard -> Security).
ADMIN_REQUIRE_2FA=false
# Bearer token for /api/v1/metrics (blocked at Nginx; for internal scrapers).
METRICS_TOKEN=
# Optional error monitoring.
SENTRY_DSN=

# --- Development admin (ENVIRONMENT=development only) ----------------------------
# Created once by the migrate service. Min 12 chars. Leave empty to skip.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=change-me-dev-admin-pass

# --- Site identity & legal (shown on public pages) -------------------------------
# Brand (farelune.com registered 2026-10-12; formal trademark clearance pending).
SITE_NAME=Farelune
LEGAL_ENTITY_NAME=
# Optional postal address; leave empty to show only the email addresses.
LEGAL_ADDRESS=
CONTACT_EMAIL=hello@farelune.com
PRIVACY_EMAIL=privacy@farelune.com

# --- Optional: Travelpayouts partner script (Drive/Emerald) -----------------------
# Leave empty to disable (default). When set, the snippet is placed in every page,
# inert until a visitor accepts partner cookies in the consent banner (Law 25).
# The ID is your Travelpayouts PROJECT id: the number in the snippet (?t=584743, trs=584743).
# With TRAVELPAYOUTS_MARKER below it also enables the Klook / Kiwi.com widgets.
TRAVELPAYOUTS_SCRIPT_ID=
# Script host from the snippet (default emrldtp.cc).
TRAVELPAYOUTS_SCRIPT_HOST=

# --- Flight data provider ------------------------------------------------------
# mock          = deterministic DEMO fares (default; shows the demo banner)
# travelpayouts = real cached fares from Aviasales via the Travelpayouts Data API
ENABLED_PROVIDERS=mock
# Secret API token (Travelpayouts dashboard -> Tools -> API). Never commit it.
TRAVELPAYOUTS_API_TOKEN=
# Your PARTNER id (public): shown top-right in the Travelpayouts dashboard and as
# shmarker= in widget snippets (e.g. 789134). Not the project id. Credits bookings to you.
TRAVELPAYOUTS_MARKER=789134
# Optional 2-letter market whose price cache to query (e.g. ca); empty = API default.
TRAVELPAYOUTS_MARKET=
# Partner booking links ("View deal" -> partner site). Also requires the provider to be
# marked live with a verified agreement in the database. See docs/COMPLIANCE.md.
REFERRALS_LIVE_ENABLED=false

# Docker image tag for this stack. Use a different value for any second stack on the
# same host (e.g. IMAGE_TAG=preview) so builds don't overwrite each other.
IMAGE_TAG=local
