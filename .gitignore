# Repository-wide ignores for _the_travel_agency.
# (global-travel-platform/.gitignore repeats the app-specific rules so the
#  project stays safe if it is ever moved into its own repository.)

# ---------------------------------------------------------------------------
# Secrets & credentials: NEVER commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
**/infrastructure/nginx/certs/

# Local-only operator notes (LAN host details)
DOCKER_HOST_SETUP.md

# ---------------------------------------------------------------------------
# Python (apps/api)
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------------------
# Node / Next.js (apps/web, packages/*)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ---------------------------------------------------------------------------
# Ops artifacts
# ---------------------------------------------------------------------------
backups/
*.dump
*.sql.gz
*.tgz
*.log

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
